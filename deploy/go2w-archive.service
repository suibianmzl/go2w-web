[Unit]
Description=Go2W TOS Archive Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/go2w-web/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/go2w-web/etc/internal.env
EnvironmentFile=-/opt/go2w-web/etc/archive.env
EnvironmentFile=-/opt/go2w-web/etc/tos.env
ExecStart=/opt/go2w-web/venv/bin/python /opt/go2w-web/current/server/archive.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
